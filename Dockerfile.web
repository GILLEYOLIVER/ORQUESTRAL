FROM node:26.5.1-alpine3.23 AS node-base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY packages/ui-components/package.json packages/ui-components/package.json
RUN pnpm install --frozen-lockfile

FROM node-base AS development
COPY apps/web apps/web
COPY packages packages
EXPOSE 5173
CMD ["pnpm", "--filter", "@orkestral/web", "dev"]

FROM node-base AS build
ARG VITE_API_BASE_URL=""
ARG DEVELOPMENT_PREVIEW_ENABLED="false"
COPY apps/web apps/web
COPY packages packages
RUN test "$DEVELOPMENT_PREVIEW_ENABLED" != "true" \
    && VITE_API_BASE_URL="$VITE_API_BASE_URL" \
       VITE_AUTH_PREVIEW_ENABLED="$DEVELOPMENT_PREVIEW_ENABLED" \
       pnpm --filter @orkestral/web build

FROM nginx:1.31.3-alpine AS production
COPY infrastructure/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html

RUN chown -R nginx:nginx /etc/nginx/conf.d /usr/share/nginx/html /var/cache/nginx \
    && touch /var/run/nginx.pid \
    && chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 8080
