FROM ghcr.io/astral-sh/uv:0.12.4 AS uv

FROM python:3.13.14-alpine3.24 AS python-base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PATH="/workspace/.venv/bin:$PATH"
WORKDIR /workspace
COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY apps/worker/pyproject.toml apps/worker/pyproject.toml
COPY packages/plugin-sdk/pyproject.toml packages/plugin-sdk/pyproject.toml

FROM python-base AS dependencies
RUN uv sync --frozen --all-packages --no-dev --no-install-workspace
COPY apps/api apps/api
COPY apps/worker apps/worker
COPY packages/plugin-sdk packages/plugin-sdk
COPY infrastructure infrastructure
RUN uv sync --frozen --all-packages --no-dev

FROM python:3.13.14-alpine3.24 AS production
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/workspace/.venv/bin:$PATH"
WORKDIR /workspace
RUN addgroup -S orkestral && adduser -S -G orkestral orkestral
COPY --from=dependencies --chown=orkestral:orkestral /workspace/.venv /workspace/.venv
COPY --from=dependencies --chown=orkestral:orkestral /workspace/apps /workspace/apps
COPY --from=dependencies --chown=orkestral:orkestral /workspace/packages /workspace/packages
COPY --from=dependencies --chown=orkestral:orkestral /workspace/infrastructure /workspace/infrastructure
USER orkestral
EXPOSE 8000
CMD ["sh", "/workspace/infrastructure/docker/api/entrypoint.sh"]

FROM python-base AS development
RUN uv sync --frozen --all-packages --all-extras --no-install-workspace
COPY apps/api apps/api
COPY apps/worker apps/worker
COPY packages/plugin-sdk packages/plugin-sdk
COPY infrastructure infrastructure
RUN uv sync --frozen --all-packages --all-extras
EXPOSE 8000
CMD ["sh", "/workspace/infrastructure/docker/api/entrypoint.sh"]
