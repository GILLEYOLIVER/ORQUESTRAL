APP_NAME=Orkestral API
APP_ENV=development
VITE_REMOTE_DEVELOPMENT=true
VITE_N8N_ENABLED=false
VITE_OBJECT_STORAGE_ENABLED=false
APP_VERSION=0.13.0
LOG_LEVEL=INFO
REMOTE_DEVELOPMENT_ENABLED=true

# Render + Neon + Upstash. Use only secrets created in provider dashboards.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379/0
CELERY_BROKER_URL=rediss://default:PASSWORD@HOST:6379/1
CELERY_RESULT_BACKEND=rediss://default:PASSWORD@HOST:6379/2
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ENCRYPTION_KEY=GENERATE_ANOTHER_32_RANDOM_CHARACTERS
ENCRYPTION_PREVIOUS_KEYS=[]
ENCRYPTION_KEY_PROVIDER=external
ENCRYPTION_KEY_REFERENCE=vault://orkestral/development/active
ENCRYPTION_PREVIOUS_KEY_REFERENCES=[]
AGENT_MEMORY_MONITOR_SECRET=GENERATE_A_DEDICATED_32_CHARACTER_MONITOR_SECRET
AGENT_MEMORY_MONITOR_PREVIOUS_SECRETS=[]
AGENT_MEMORY_MONITOR_SECRET_ROTATED_AT=SET_CURRENT_ISO8601_TIMESTAMP
AGENT_MEMORY_MONITOR_SECRET_MAX_AGE_DAYS=90
AGENT_MEMORY_REENCRYPTION_TERMINAL_RETENTION_DAYS=90
CORS_ORIGINS=[]
SECURITY_TRUSTED_PROXY_IPS=[]
SECURITY_ENFORCE_ORIGIN=true
SECURITY_ENFORCE_JSON_CONTENT_TYPE=true

# Reduced free development mode.
N8N_ENABLED=false
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_SSE_ENABLED=false
BACKGROUND_WORKER_ENABLED=false
EMAIL_DELIVERY_ENABLED=false
DEVELOPMENT_EXPOSE_TOKENS=false
WEB_STATIC_DIRECTORY=/workspace/apps/web/dist

# Optional remote seed. Set the password only as a provider secret.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_NAME=Administrador Orkestral
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_COMPANY_NAME=Orkestral Development
BOOTSTRAP_COMPANY_SLUG=orkestral-development
BOOTSTRAP_COMPANY_DOCUMENT=REMOTE-DEVELOPMENT

# Disabled services retain syntactically valid placeholders and are never contacted.
N8N_BASE_URL=https://n8n-disabled.invalid
N8N_API_KEY=disabled-in-remote-development
STORAGE_ENDPOINT=https://storage-disabled.invalid
STORAGE_ACCESS_KEY=disabled
STORAGE_SECRET_KEY=disabled-in-remote-development
STORAGE_BUCKET=orkestral-development
GIT_COMMIT_SHA=local
DEPLOYED_AT=
