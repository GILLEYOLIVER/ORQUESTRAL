# Contract only. Replace every REQUIRED value with a protected environment secret.
APP_ENV=staging
APP_VERSION=0.13.0
DATABASE_URL=
MIGRATION_DATABASE_URL=postgresql+asyncpg://REQUIRED_MIGRATION_USER:REQUIRED_PASSWORD@REQUIRED_DATABASE_HOST/orkestral?ssl=require
API_DATABASE_URL=postgresql+asyncpg://REQUIRED_API_USER:REQUIRED_PASSWORD@REQUIRED_DATABASE_HOST/orkestral?ssl=require
WORKER_DATABASE_URL=postgresql+asyncpg://REQUIRED_WORKER_USER:REQUIRED_PASSWORD@REQUIRED_DATABASE_HOST/orkestral?ssl=require
DATABASE_PROCESS_ROLE=api
DATABASE_ROLE_SEPARATION_REQUIRED=true
REDIS_URL=rediss://default:REQUIRED_PASSWORD@REQUIRED_REDIS_HOST:6379/0
CELERY_BROKER_URL=rediss://default:REQUIRED_PASSWORD@REQUIRED_REDIS_HOST:6379/1
CELERY_RESULT_BACKEND=rediss://default:REQUIRED_PASSWORD@REQUIRED_REDIS_HOST:6379/2
JWT_SECRET=REQUIRED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ENCRYPTION_KEY=REQUIRED_DIFFERENT_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=["https://staging.example.invalid"]
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_REQUESTS=300
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_AUTH_RATE_LIMIT_REQUESTS=20
SECURITY_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
SECURITY_HSTS_SECONDS=31536000
SECURITY_TRUSTED_PROXY_IPS=[]
SECURITY_ENFORCE_ORIGIN=true
SECURITY_ENFORCE_JSON_CONTENT_TYPE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_WINDOW_SECONDS=900
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_IP_MAX_ATTEMPTS=10
ENCRYPTION_KEY_PROVIDER=external
ENCRYPTION_KEY_REFERENCE=REQUIRED_VAULT_REFERENCE
ENCRYPTION_PREVIOUS_KEYS=[]
ENCRYPTION_PREVIOUS_KEY_REFERENCES=[]
AGENT_MEMORY_MONITOR_SECRET=REQUIRED_DEDICATED_MONITOR_SECRET_AT_LEAST_32_CHARACTERS
AGENT_MEMORY_MONITOR_PREVIOUS_SECRETS=[]
AGENT_MEMORY_MONITOR_SECRET_ROTATED_AT=SET_CURRENT_ISO8601_TIMESTAMP
AGENT_MEMORY_MONITOR_SECRET_ROTATION_POLICY=enforce
DEVELOPMENT_EXPOSE_TOKENS=false
REMOTE_DEVELOPMENT_ENABLED=false
BOOTSTRAP_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=true
RUN_MIGRATIONS_ON_STARTUP=false
GIT_COMMIT_SHA=REQUIRED_RELEASE_SHA
DEPLOYED_AT=REQUIRED_ISO8601_TIMESTAMP
