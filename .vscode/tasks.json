{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Orkestral: iniciar ambiente",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/dev.sh", "start"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\dev.ps1",
          "start"
        ]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Orkestral: iniciar sem rebuild",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/dev.sh", "start", "--no-build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\dev.ps1",
          "start",
          "-NoBuild"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Orkestral: encerrar ambiente",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/dev.sh", "stop"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\dev.ps1",
          "stop"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Orkestral: mostrar status",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/dev.sh", "status"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\dev.ps1",
          "status"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Orkestral: acompanhar logs",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.example",
        "-f",
        "docker-compose.yml",
        "-f",
        "docker-compose.development.yml",
        "logs",
        "-f",
        "--tail",
        "100",
        "api",
        "web",
        "nginx"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
