APP_ENV=testing
APP_VERSION=0.13.0
DATABASE_URL=postgresql+asyncpg://orkestral:testing-secret@postgres:5432/orkestral
MIGRATION_DATABASE_URL=
API_DATABASE_URL=
WORKER_DATABASE_URL=
DATABASE_PROCESS_ROLE=api
DATABASE_ROLE_SEPARATION_REQUIRED=false
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
JWT_SECRET=testing-jwt-secret-with-at-least-32-characters
ENCRYPTION_KEY=testing-encryption-key-at-least-32-characters
CORS_ORIGINS=[]
SECURITY_RATE_LIMIT_ENABLED=false
SECURITY_AUTH_RATE_LIMIT_REQUESTS=20
SECURITY_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_IP_MAX_ATTEMPTS=10
DEVELOPMENT_EXPOSE_TOKENS=false
BOOTSTRAP_ENABLED=false
GIT_COMMIT_SHA=testing
