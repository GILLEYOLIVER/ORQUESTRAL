# Aplicação — valores exclusivamente locais; não reutilize em produção.
APP_NAME=Orkestral API
APP_ENV=development
APP_VERSION=0.4.0
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://orkestral:development-only-change-me@postgres:5432/orkestral
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CORS_ORIGINS=["http://localhost","http://localhost:5173"]
DEPENDENCY_TIMEOUT_SECONDS=2
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
INVITATION_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
DEVELOPMENT_EXPOSE_TOKENS=true

# Segredos de desenvolvimento — a API rejeita estes valores quando APP_ENV=production.
JWT_SECRET=development-only-change-me-jwt-secret-32-chars
ENCRYPTION_KEY=development-only-change-me-encryption-key-32
N8N_API_KEY=development-only-change-me-n8n-api-key
N8N_ENCRYPTION_KEY=development-only-change-me-n8n-encryption-key
STORAGE_ACCESS_KEY=development-only
STORAGE_SECRET_KEY=development-only-change-me-storage-secret

# Serviços internos
POSTGRES_DB=orkestral
POSTGRES_USER=orkestral
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_HOST_PORT=15432
N8N_BASE_URL=http://n8n:5678
STORAGE_ENDPOINT=http://object-storage:9000
STORAGE_BUCKET=orkestral
MINIO_ROOT_USER=development-only
MINIO_ROOT_PASSWORD=development-only-change-me-storage-secret

# Bootstrap idempotente — executado somente no desenvolvimento local.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_NAME=Administrador Orkestral
BOOTSTRAP_ADMIN_EMAIL=admin@orkestral.dev.br
BOOTSTRAP_ADMIN_PASSWORD=Orkestral-Dev-2026!
BOOTSTRAP_COMPANY_NAME=Orkestral Desenvolvimento
BOOTSTRAP_COMPANY_SLUG=orkestral-dev
BOOTSTRAP_COMPANY_DOCUMENT=DEV-ORKESTRAL-001

# Front-end — recursos abaixo existem apenas no servidor Vite de desenvolvimento.
VITE_API_BASE_URL=/api
VITE_AUTH_PREVIEW_ENABLED=true
VITE_DEV_ADMIN_LOGIN_ENABLED=true
VITE_DEV_ADMIN_EMAIL=admin@orkestral.dev.br
VITE_DEV_ADMIN_PASSWORD=Orkestral-Dev-2026!
