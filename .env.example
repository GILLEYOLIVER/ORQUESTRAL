# Aplicação — valores exclusivamente locais; não reutilize em produção.
APP_NAME=Orkestral API
APP_ENV=local
APP_VERSION=0.13.0
COMPOSE_ENV_FILE=.env.example
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://orkestral:development-only-change-me@postgres:5432/orkestral
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CORS_ORIGINS=["http://localhost","http://localhost:5173"]
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_REQUESTS=300
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_MAX_BODY_BYTES=26214400
SECURITY_HSTS_SECONDS=31536000
SECURITY_TRUSTED_PROXY_IPS=[]
SECURITY_ENFORCE_ORIGIN=true
SECURITY_ENFORCE_JSON_CONTENT_TYPE=true
AUDIT_CAPTURE_ENABLED=true
AUDIT_RETENTION_DAYS=365
BILLING_ENFORCEMENT_ENABLED=false
DEPENDENCY_TIMEOUT_SECONDS=2
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
INVITATION_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
DEVELOPMENT_EXPOSE_TOKENS=true
REMOTE_DEVELOPMENT_ENABLED=false
N8N_ENABLED=true
OBJECT_STORAGE_ENABLED=true
BACKGROUND_WORKER_ENABLED=true
EMAIL_DELIVERY_ENABLED=true
WEB_STATIC_DIRECTORY=
GIT_COMMIT_SHA=local
DEPLOYED_AT=

# Segredos de desenvolvimento — a API rejeita estes valores quando APP_ENV=production.
JWT_SECRET=development-only-change-me-jwt-secret-32-chars
JWT_PREVIOUS_SECRETS=[]
ENCRYPTION_KEY=development-only-change-me-encryption-key-32
ENCRYPTION_PREVIOUS_KEYS=[]
ENCRYPTION_KEY_PROVIDER=environment
ENCRYPTION_KEY_REFERENCE=environment://orkestral/local/active
ENCRYPTION_PREVIOUS_KEY_REFERENCES=[]
AGENT_MEMORY_MONITOR_SECRET=development-only-change-me-agent-memory-monitor-secret-32
N8N_API_KEY=development-only-change-me-n8n-api-key
N8N_ENCRYPTION_KEY=development-only-change-me-n8n-encryption-key
STORAGE_ACCESS_KEY=development-only
STORAGE_SECRET_KEY=development-only-change-me-storage-secret

# Serviços internos
POSTGRES_DB=orkestral
POSTGRES_USER=orkestral
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_HOST_PORT=15432
N8N_BASE_URL=http://n8n:5678
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_INPUT_COST_PER_MILLION_TOKENS_MICROUSD=150000
AI_OUTPUT_COST_PER_MILLION_TOKENS_MICROUSD=600000
KNOWLEDGE_MAX_FILE_BYTES=20971520
KNOWLEDGE_WEB_ALLOWED_DOMAINS=[]
KNOWLEDGE_EMBEDDING_PROVIDER=local_hash
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=384
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
STORAGE_ENDPOINT=http://object-storage:9000
STORAGE_BUCKET=orkestral
OBJECT_STORAGE_SSE_ENABLED=true
MINIO_ROOT_USER=development-only
MINIO_ROOT_PASSWORD=development-only-change-me-storage-secret

# Bootstrap idempotente — executado somente no desenvolvimento local.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_NAME=Administrador Orkestral
BOOTSTRAP_ADMIN_EMAIL=admin@orkestral.dev.br
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_COMPANY_NAME=Orkestral Desenvolvimento
BOOTSTRAP_COMPANY_SLUG=orkestral-dev
BOOTSTRAP_COMPANY_DOCUMENT=DEV-ORKESTRAL-001

# Front-end — a prévia nunca deve ser habilitada em produção.
VITE_API_BASE_URL=/api
VITE_AUTH_PREVIEW_ENABLED=true

# Canais externos opcionais. A entrega ocorre somente quando o usuário autoriza o canal.
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_URL=
NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=10
NOTIFICATION_REMINDER_MINUTES=30
