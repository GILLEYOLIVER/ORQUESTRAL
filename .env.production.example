# Safe production contract. Empty values must come from the provider secret manager.
APP_NAME=Orkestral API
APP_ENV=production
APP_VERSION=
LOG_LEVEL=INFO
DATABASE_URL=
MIGRATION_DATABASE_URL=
API_DATABASE_URL=
WORKER_DATABASE_URL=
DATABASE_PROCESS_ROLE=api
DATABASE_ROLE_SEPARATION_REQUIRED=true
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CORS_ORIGINS=[]
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_REQUESTS=300
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_AUTH_RATE_LIMIT_REQUESTS=20
SECURITY_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
REQUEST_MAX_BODY_BYTES=26214400
SECURITY_HSTS_SECONDS=31536000
SECURITY_TRUSTED_PROXY_IPS=[]
SECURITY_ENFORCE_ORIGIN=true
SECURITY_ENFORCE_JSON_CONTENT_TYPE=true
AUDIT_CAPTURE_ENABLED=true
AUDIT_RETENTION_DAYS=365
BILLING_ENFORCEMENT_ENABLED=true
DEPENDENCY_TIMEOUT_SECONDS=2
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
INVITATION_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_WINDOW_SECONDS=900
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_IP_MAX_ATTEMPTS=10
DEVELOPMENT_EXPOSE_TOKENS=false
REMOTE_DEVELOPMENT_ENABLED=false
N8N_ENABLED=true
OBJECT_STORAGE_ENABLED=true
BACKGROUND_WORKER_ENABLED=true
EMAIL_DELIVERY_ENABLED=true
WEB_STATIC_DIRECTORY=/workspace/apps/web/dist
RUN_MIGRATIONS_ON_STARTUP=false
GIT_COMMIT_SHA=
DEPLOYED_AT=

# Secrets. Never commit real values.
JWT_SECRET=
JWT_PREVIOUS_SECRETS=[]
ENCRYPTION_KEY=
ENCRYPTION_PREVIOUS_KEYS=[]
ENCRYPTION_KEY_PROVIDER=external
ENCRYPTION_KEY_REFERENCE=
ENCRYPTION_PREVIOUS_KEY_REFERENCES=[]
AGENT_MEMORY_MONITOR_SECRET=
AGENT_MEMORY_MONITOR_PREVIOUS_SECRETS=[]
AGENT_MEMORY_MONITOR_SECRET_ROTATED_AT=
AGENT_MEMORY_MONITOR_SECRET_ROTATION_POLICY=enforce
N8N_API_KEY=
N8N_ENCRYPTION_KEY=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
AI_PROVIDER_API_KEY=

# Managed services.
N8N_BASE_URL=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_INPUT_COST_PER_MILLION_TOKENS_MICROUSD=150000
AI_OUTPUT_COST_PER_MILLION_TOKENS_MICROUSD=600000
KNOWLEDGE_MAX_FILE_BYTES=20971520
KNOWLEDGE_WEB_ALLOWED_DOMAINS=[]
KNOWLEDGE_EMBEDDING_PROVIDER=openai_compatible
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=384
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
STORAGE_ENDPOINT=
STORAGE_BUCKET=orkestral-production

# Bootstrap and preview are forbidden in production.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_COMPANY_NAME=
BOOTSTRAP_COMPANY_SLUG=
BOOTSTRAP_COMPANY_DOCUMENT=
VITE_API_BASE_URL=/api
VITE_AUTH_PREVIEW_ENABLED=false

# Optional notification providers.
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_URL=
NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=10
NOTIFICATION_REMINDER_MINUTES=30
